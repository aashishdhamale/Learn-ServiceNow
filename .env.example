# Copy to .env (or run `pnpm setup:env`, which `pnpm dev` does for you and which
# generates TOKEN_ENCRYPTION_KEY). Never commit .env.

# --- Database -----------------------------------------------------------------
# docker-compose.yml reads the POSTGRES_* values; DATABASE_URL must match them.
POSTGRES_USER=snow
POSTGRES_PASSWORD=snow
POSTGRES_DB=snow_mastery
POSTGRES_PORT=5432
DATABASE_URL=postgresql://snow:snow@localhost:5432/snow_mastery?schema=public
# Set to 1 to skip `docker compose up` in `pnpm dev` and use DATABASE_URL as-is.
SKIP_DOCKER=0

# --- App ----------------------------------------------------------------------
# Public base URL of the web app. The PDI OAuth redirect URL is APP_URL/api/pdi/oauth/callback.
APP_URL=http://localhost:3000
# Phase 1 has a single local learner (no login). This is that learner's identity.
LOCAL_LEARNER_EMAIL=learner@localhost
# 32 random bytes, base64. Encrypts OAuth client secrets and tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- ServiceNow client ----------------------------------------------------------
SNOW_HTTP_TIMEOUT_MS=15000
SNOW_MAX_RETRIES=3
# How long layer 3 waits for an ATF suite run to finish.
ATF_TIMEOUT_MS=600000
# Tests/e2e only: send all ServiceNow traffic to this base URL instead of
# https://<instance>.service-now.com. "{instance}" is substituted if present.
SNOW_INSTANCE_URL_TEMPLATE=

# --- AI architect review (layer 4) ---------------------------------------------
# live = call Claude; mock = canned feedback (tests/e2e); off = skip layer 4.
AI_REVIEW_MODE=live
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
