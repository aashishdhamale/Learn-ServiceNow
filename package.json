{
  "name": "snow-architect-mastery",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup:env": "node scripts/ensure-env.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @snow-mastery/web test:e2e",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @snow-mastery/db migrate:dev",
    "db:deploy": "pnpm --filter @snow-mastery/db migrate:deploy",
    "db:studio": "pnpm --filter @snow-mastery/db studio",
    "scenarios:validate": "pnpm --filter @snow-mastery/scenarios validate",
    "scenarios:sync": "pnpm --filter @snow-mastery/db scenarios:sync",
    "postinstall": "pnpm --filter @snow-mastery/db generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
